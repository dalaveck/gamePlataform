# Copie para .env.local (ignorado pelo git — ver .gitignore *.local) e
# preencha com os valores do seu projeto Firebase (Console Firebase →
# Configurações do projeto → Seus apps → Config do SDK).
#
# Sem essas variáveis o app roda normalmente, mas a aba "Mesa / Sessão"
# (Fase 2 do ROADMAP.md — sala multiplayer) fica desativada.
#
# Habilite no Firebase: Firestore Database (modo produção) e
# Authentication → Sign-in method → Anônimo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
